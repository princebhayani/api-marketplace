# ============================================
# API Marketplace Frontend - Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# ============================================
# API Configuration
# ============================================
# Backend API Base URL
# 
# Development: Use proxy (leave empty or set to /api)
#   - Vite will proxy /api requests to backend
#   - Empty value defaults to "/api"
#
# Production: Set to your backend API URL
#   - Example: https://api.example.com
#   - Example: https://api.example.com/api
#
# Note: In development, the vite.config.ts proxy handles /api routing
#       In production, you may need to configure your server/proxy
NEXT_PUBLIC_API_BASE_URL=/api
API_PROXY_TARGET=http://localhost:4000

# Socket.IO / Gateway URL (direct backend connection for real-time updates)
# Development: http://localhost:4000
# Production: https://api.yourdomain.com
NEXT_PUBLIC_GATEWAY_BASE_URL=http://localhost:4000

# ============================================
# Firebase Configuration
# ============================================
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id

# ============================================
# Environment-Specific Examples
# ============================================

# Development (local)
# VITE_API_BASE_URL=
# or
# VITE_API_BASE_URL=http://localhost:4000

# Staging
# VITE_API_BASE_URL=https://api-staging.example.com

# Production
# VITE_API_BASE_URL=https://api.example.com

# ============================================
# Production Notes
# ============================================
# 1. Build the application: npm run build
# 2. The .env file is used during build time
# 3. Environment variables must be prefixed with VITE_ to be accessible in the app
# 4. After build, environment variables are embedded in the bundle
# 5. For different environments, use different .env files:
#    - .env.development
#    - .env.staging
#    - .env.production
# 6. Or use your deployment platform's environment variable configuration
